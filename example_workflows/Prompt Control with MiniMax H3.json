      "widgets_values": [
        "\nSEG(node)\n# This gets put in a SEG so it can be concatenated to the main prompt neatly. Syntax: NODE(NodeID, prompt_input_name, extra_args...). You might need to look into the API-format JSON to find the real input names of the node.\nNODE(UC_AdvancedMiniMaxH3ImageToVideo, prompt,\nvae $a;\nwidth $b;\nheight $c;\nlength $d;\n# Omit first_frame entirely at first, giving t2v\n[first_frame [$e:$f:0.4];:0.2]\n# autogrow looks like this:\n# reference_images.reference_image_1 $f;\n# Syntax for literals is JSON.\nref_image_size \"none\";\nvlm_resolution 1024\n)\n"
